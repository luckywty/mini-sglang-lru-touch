+    batch, used = advance(s)
+    assert batch.is_prefill and used == 4 and pending.chunked_req.cached_len == 4
+    table, handle = pending.chunked_req.table_idx, pending.chunked_req.cache_handle
+    assert other.waiting_passes == 1
+    for uid in (0, 1):
