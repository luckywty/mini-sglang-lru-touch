+            match_len = align_down(match_len, self.page_size)
+            if match_len == 0:
+                break
+            prefix_len += match_len
+            if match_len != node.length:
+                # partial edge: count fully-matched pages only, do not split
+                break
+        return prefix_len
+
 
 
