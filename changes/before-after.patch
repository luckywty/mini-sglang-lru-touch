+        #必须整条路径都刷：evict() 先淘汰叶子，叶子删完后会把 parent 推入堆，
+        #祖先节点时间戳过期会导致 LRU 判序错误。
+        assert isinstance(handle, RadixCacheHandle)
+        tic = time.monotonic_ns()
+        node = handle.node
+        while not node.is_root():
+            node.timestamp = tic
+            node = node.parent
